{
  "name": "gcp-quota-management-backend",
  "version": "1.0.0",
  "description": "Backend API for Google Cloud Quota Management and Increase Request Planning",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "db:migrate": "node scripts/run-sql-migration.js",

