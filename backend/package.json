    "google-auth-library": "^9.15.1",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "keywords": [
    "gcp",
