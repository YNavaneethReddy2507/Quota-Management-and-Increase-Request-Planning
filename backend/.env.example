# ==============================================================================
# Backend Environment Configuration Template
# Quota Management and Increase Request Planning Control Plane
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=quota_user
DB_PASSWORD=quota_secure_password
DB_NAME=quota_management

# Prisma / ORM Connection String
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://quota_user:quota_secure_password@127.0.0.1:3306/quota_management"

# Google Cloud Platform Authentication & Project Settings
# Path to service account JSON key file (created in Phase 3)
GOOGLE_APPLICATION_CREDENTIALS=./infra/credentials/quota-manager-sa-key.json
GCP_PROJECT_ID=my-gcp-project-id

# Notification Service Webhook URL (Slack incoming webhook, Discord, etc.)
WEBHOOK_URL=https://example.com/api/webhook-placeholder

# Ingestion Cron Schedule (Default: Every hour '0 * * * *')
SYNC_CRON_SCHEDULE="0 * * * *"

# Risk & Alert Thresholds
HIGH_RISK_THRESHOLD_PERCENT=80.0
